{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homecall-metadata",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "ALLOWED_ORIGINS": "[\"https://michaeltorbert.github.io\"]",
    "ENABLE_CATALOG_REFRESH": "false"
  },
  "env": {
    "local": {
      "name": "homecall-metadata-local",
      "vars": {
        "ALLOWED_ORIGINS": "[\"http://127.0.0.1:4178\",\"http://localhost:4178\",\"http://127.0.0.1:4179\",\"http://localhost:4179\"]"
      },
      "kv_namespaces": [
        {
          "binding": "STREAM_CATALOG",
          "id": "local-private-catalog"
        }
      ],
      "triggers": {
        "crons": []
      }
    },
    "preview": {
      "name": "homecall-private-streams-preview",
      "vars": {
        "ALLOWED_ORIGINS": "[\"https://michaeltorbert.github.io\",\"http://127.0.0.1:4178\",\"http://127.0.0.1:4179\"]",
        "ENABLE_CATALOG_REFRESH": "false"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "kv_namespaces": [
        {
          "binding": "STREAM_CATALOG",
          "id": "c8f03da2bcc044319673270407f822e0"
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  },
  "triggers": {
    "crons": [
      "17 */6 * * *"
    ]
  }
}
