{
  "name": "homecall",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node server.mjs",
    "build": "npm run check:gateway && node scripts/check-private-urls.mjs && vite build && node scripts/check-private-urls.mjs --dist",
    "check:gateway": "node scripts/check-gateway.mjs",
    "worker:dev": "wrangler dev --local --env local --ip 127.0.0.1 --port 8787",
    "worker:dry-run": "wrangler deploy --env=\"\" --dry-run --outdir output/worker-dry-run",
    "worker:deploy": "node scripts/check-worker-deploy.mjs && wrangler deploy --env=\"\"",
    "worker:types": "wrangler types output/worker-configuration.d.ts",
    "test:worker": "node scripts/test-worker.mjs",
    "check:private": "node scripts/check-private-urls.mjs",
    "worker:preview": "VITE_GATEWAY_ORIGIN=https://homecall-private-streams-preview.homecall.workers.dev npm run build && wrangler deploy --env preview",
    "check:home-screen-install": "node .github/scripts/check-home-screen-install.mjs src/vendor/home-screen-install esm"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "mpg123-decoder": "1.0.3",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "miniflare": "5.20261012.0-beta",
    "wrangler": "4.151.0"
  }
}
